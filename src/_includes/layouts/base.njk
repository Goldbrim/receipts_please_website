<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = title + " — " + site.name if title else site.name + " — " + site.tagline %}
  {%- set canonical = page.url | absoluteUrl(site.url) %}
  {%- set ogImage = "/assets/og-image.png" | absoluteUrl(site.url) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ description }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ canonical }}">
  {%- endif %}
  <meta name="theme-color" content="{{ site.themeColor }}">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" href="/assets/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="stylesheet" href="/styles.css?v={{ build.assetVersion }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.name }} — {{ site.tagline }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if structuredData %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}/",
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.company }}",
      "email": "{{ site.email }}",
      "logo": "{{ site.url }}/assets/icon-512.png"
    }
  }
  </script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/"><img src="/assets/logo.png" width="37" height="37" alt="">{{ site.name }}</a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {%- for item in nav %}
        <a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
      {%- if site.playStoreUrl %}
      <a class="nav-status" href="{{ site.playStoreUrl }}">Get the app</a>
      {%- else %}
      <span class="nav-status">Coming Soon</span>
      {%- endif %}
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          {%- for item in nav %}
          <a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- endfor %}
        </nav>
      </details>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">{{ site.name }}<p>{{ site.tagline }}</p></div>
      <nav class="footer-links" aria-label="Footer navigation">
        {%- for item in nav %}
        <a href="{{ item.url }}">{{ item.footerLabel }}</a>
        {%- endfor %}
      </nav>
      <div class="footer-meta">© {{ build.year }} {{ site.company }}. {{ site.shortName }} is a product of {{ site.company }}.</div>
    </div>
  </footer>
</body>
</html>
